// Shared neutral text-entry dialog. Uses only Windows 7-compatible controls.
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
32000 DIALOGEX 0, 0, 340, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Enter lines"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Enter complete lines, then choose Apply. Cancel keeps the document unchanged.", 32002, 8, 8, 324, 24
    EDITTEXT 32001, 8, 35, 324, 164, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Apply", IDOK, 220, 208, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 278, 208, 54, 14
END
